// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

// 品牌（Brand）表
model Brand {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  alias       Jsonb
  logoUrl     String?
  officialUrl String?
  createdAt   Timestamp(6) @default(now())
  animes      Anime[]
}

// 动画（Anime）表
model Anime {
  id        Int          @id @default(autoincrement())
  brandId   Int?
  name      String       @unique
  alias     Jsonb
  overview  Jsonb
  createdAt Timestamp(6) @default(now())
  brand     Brand?       @relation(fields: [brandId], references: [id])
}

// 剧集（Episode）表
model Episode {
  id            Int            @id @default(autoincrement())
  animeId       Int
  name          String
  alias         Jsonb
  seasonNumber  SmallInt
  episodeNumber SmallInt
  productCode   String?
  posterUrl     String?
  coverUrl      String?
  officialUrl   String?
  previewUrls   String[]
  duration      SmallInt?
  airDate       Date
  overview      Jsonb
  createdAt     Timestamp(6)   @default(now())
  tags          EpisodeTag[]
}

// 标签（Tag）表
model Tag {
  id            Int            @id @default(autoincrement())
  name          String
  alias         Jsonb
  createdAt     Timestamp(6)   @default(now())
  episodes      EpisodeTag[]
}

// 剧集标签关联（EpisodeTag）表
model EpisodeTag {
  episodeId Int
  tagId     Int
  episode   Episode @relation(fields: [episodeId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])
}
